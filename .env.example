# Application Configuration
APP_NAME="Zerodha Algorithmic Trading Platform"
APP_ENV="production"
SECRET_KEY="replace_with_a_secure_random_32_byte_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
POSTGRES_USER="algo_user"
POSTGRES_PASSWORD="secure_db_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="zerodha_algo_db"
DATABASE_URL="postgresql+psycopg2://algo_user:secure_db_password@localhost:5432/zerodha_algo_db"

# Zerodha Kite Connect Configuration
KITE_API_KEY="your_kite_api_key"
KITE_API_SECRET="your_kite_api_secret"
KITE_ACCESS_TOKEN=""

# Global Risk Controls
MAX_DAILY_LOSS=5000.0
MAX_TRADES_PER_DAY=20
MAX_POSITION_SIZE=50000.0
SL_PERCENTAGE=1.0
TARGET_PERCENTAGE=2.0
TRAILING_SL_PERCENTAGE=0.5
MAX_REPEATED_FAILURES=3
TRADING_WINDOW_START="09:15"
TRADING_WINDOW_END="15:15"
SQUARE_OFF_TIME="15:15"

# Server & Logging Settings
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
LOG_DIR="./logs"
